# Salin jadi .env lalu sesuaikan. Jangan pernah commit .env asli.

# === DATABASE ===
# Produksi/serverless (Supabase): pakai koneksi POOLED dari dashboard Supabase
# (Project Settings > Database > Connection string > "Transaction pooler"),
# port 6543, tambahkan ?pgbouncer=true&connection_limit=1
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# === AUTH ===
# Kunci sesi JWT. WAJIB ganti di produksi, minimal 32 karakter acak:
#   openssl rand -hex 32
AUTH_SECRET="ganti-dengan-32-karakter-acak"

# === SUPABASE STORAGE (avatar) ===
# Ambil dari Project Settings > API. Service role key HANYA untuk server,
# jangan pernah dikirim ke browser.
# SUPABASE_URL="https://<ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""

# === EKSEKUSI KODE (judge) ===
# Produksi/serverless: wajib instance Piston eksternal (VPS kecil / Fly.io).
# PISTON_URL="http://<ip-vps>:2000/api/v2"
# PISTON_KEY=""

# Local runner hanya untuk pengembangan di mesin sendiri.
# Di produksi (NODE_ENV=production) otomatis nonaktif kecuali di-set "true".
ENABLE_LOCAL_RUNNER="true"

# Isi konten kursus saat container start (hanya bila database kosong).
SEED_ON_START="true"

# Port Next.js di dalam container.
PORT=3000
